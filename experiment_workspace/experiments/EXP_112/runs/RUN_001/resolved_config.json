  "study": {
    "id": "112_history_reliability",
    "description": "Row-local history reliability representation",
    "hypothesis": "Explicit sample-size buckets and reliability-weighted as-of rates will make the latest CatBoost robust to the 2024 new-player and small-history population identified in EDA.",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "main72_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },

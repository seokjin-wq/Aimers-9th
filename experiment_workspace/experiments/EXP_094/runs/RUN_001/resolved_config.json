{
  "study": {
    "id": "094_count_calibration_repro",
    "description": "현재 최고 count OOT 보정의 fresh-run 재현성 감사",
    "hypothesis": "count k500 개선이 GPU 변동보다 커 새 실행에서도 control을 이긴다.",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "triple_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "triple_control",
      "change": "control: EXP_087 same-hand triple fresh run",
      "model": {
        "name": "triple_cpu45_gpu40_extra15",
        "family": "cat_cpu_gpu_extra_blend",
        "cpu_weight": 0.45,
        "gpu_weight": 0.4,
        "extra_weight": 0.15,
        "season_decay": 0.85,
        "cat_scale": 1.06,
        "cat_shift": -0.008,
        "extra_shift": -0.01,
        "cpu_params": {
          "iterations": 300,
          "depth": 8,
          "learning_rate": 0.035,
          "l2_leaf_reg": 3.0,
          "subsample": 0.7,
          "random_seed": 42,
          "thread_count": 8,
          "task_type": "CPU",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        },
        "gpu_params": {
          "iterations": 600,
          "depth": 7,
          "learning_rate": 0.025,
          "l2_leaf_reg": 3.0,
          "bootstrap_type": "Bayesian",
          "bagging_temperature": 1.0,
          "border_count": 128,
          "random_seed": 42,
          "task_type": "GPU",
          "devices": "0",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        },
        "extra_params": {
          "n_estimators": 300,
          "min_samples_leaf": 20,
          "max_features": 0.7,
          "n_jobs": 8,
          "random_state": 42,
          "verbose": 0
        }
      },
      "features": {
        "name": "main72_cat_count_hands_same_pitchmix",
        "description": "EXP_080 CPU base plus same-hand by three historical pitch-mix interactions",
        "include_all_raw": true,
        "exclude": [

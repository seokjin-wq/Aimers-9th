{
  "study": {
    "id": "102_count_triple_weights",
    "description": "Count-calibrated triple weight refinement",
    "hypothesis": "On the latest features and corrected cache, a nearby CPU/GPU/ExtraTrees mixture improves the count-calibrated ensemble beyond 45/40/15.",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "w45_40_15_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "w45_40_15_control",
      "change": "control: EXP_101 CPU45 GPU40 Extra15",
      "model": {
        "name": "triple_group_count_k500_catshift_m0095",
        "family": "cat_cpu_gpu_extra_blend",
        "cpu_weight": 0.45,
        "gpu_weight": 0.4,
        "extra_weight": 0.15,
        "season_decay": 0.85,
        "cat_scale": 1.06,
        "cat_shift": -0.0095,
        "extra_shift": -0.01,
        "group_columns": [
          "balls_before",
          "strikes_before"
        ],
        "group_shrinkage": 500.0,
        "center_residual": true,
        "residual_scale": 1.0,
        "cpu_params": {
          "iterations": 300,
          "depth": 8,
          "learning_rate": 0.035,
          "l2_leaf_reg": 3.0,
          "subsample": 0.7,
          "random_seed": 42,
          "thread_count": 8,
          "task_type": "CPU",

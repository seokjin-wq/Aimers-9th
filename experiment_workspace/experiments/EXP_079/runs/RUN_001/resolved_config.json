  "study": {
    "id": "079_count_hand_interaction",
    "description": "카운트×손 범주 상호작용 분해",
    "hypothesis": "EXP_078 개선은 카운트와 특정 손 유형의 결합에서 나오며 불필요한 범주를 제거하면 더 개선된다.",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "count_both_hands_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },

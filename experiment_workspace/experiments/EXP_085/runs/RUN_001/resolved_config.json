{
  "study": {
    "id": "085_history_missingness",
    "description": "EDA 기반 최근·선수 이력 결측 신호 재검증",
    "hypothesis": "결측 여부 자체가 시즌 초와 신규 선수 상태를 나타내므로 현재 강한 모델에서도 추가 신호를 준다.",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "count_hands_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [

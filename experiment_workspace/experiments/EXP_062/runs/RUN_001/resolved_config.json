{
  "study": {
    "id": "062_d8_decay_cat_extra_blend",
    "description": "depth8 최근성 CatBoost 이종 앙상블",
    "hypothesis": "EXP_060의 최근성 depth8 CatBoost와 ExtraTrees를 혼합하면 새 최고 구성의 편향과 분산을 동시에 낮춘다",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "cat_d8_decay85"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },

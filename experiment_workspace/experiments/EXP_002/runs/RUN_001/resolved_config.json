{
  "study": {
    "id": "002_feature_ablation",
    "description": "CatBoost 설정을 고정한 main55 피처 출처의 2024 holdout ablation",
    "hypothesis": "달력·상태·context 피처 묶음이 2024 홀드아웃 Brier를 개선한다.",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "main55_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "main55_control",
      "change": "control: 선택 제공 41개 + 파생 14개",
      "model": {
        "name": "catboost_default",
        "family": "catboost",
        "params": {
          "iterations": 300,
          "depth": 6,
          "learning_rate": 0.05,
          "l2_leaf_reg": 3.0,
          "subsample": 0.7,
          "random_seed": 42,
          "thread_count": 8,
          "task_type": "CPU",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        }
      },
      "features": {
        "name": "main55",
        "description": "선택 제공 41개와 행 단위 파생 14개",
        "include_all_raw": true,
        "exclude": [
          "run_total_before",
          "score_diff_home",
          "asof_pitcher_pitchmix_n",
          "asof_pitcher_strike_rate",
          "asof_pitcher_fastball_rate",
          "asof_pitcher_prev5_game_success_rate"
        ],
        "custom": [
          "pitcher_gap_prev1_career",
          "pitcher_gap_prev3_career",
          "pitcher_gap_prev5_career",
          "win_expectancy_dist50",
          "count_diff",
          "count_total",
          "same_hand_matchup",
          "pressure_x_recent_form",
          "runners_x_li",
          "batter_success_rate_shrunk",
          "reverse_rate_x_li",
          "middle_rate_x_count_diff",
          "late_inning_x_recent_form",
          "offspeed_x_li"
        ],
        "categorical": [
          "top_bottom",
          "game_type",
          "base_state"
        ],
        "expected_count": 55
      },
      "changed_fields_vs_control": []
    },

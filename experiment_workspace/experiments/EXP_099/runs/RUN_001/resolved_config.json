{
  "study": {
    "id": "099_latest_season_decay",
    "description": "Latest-feature season-decay refinement",
    "hypothesis": "The broad EXP_060 optimum near 0.85 can be refined on the latest 72-feature set to improve temporal generalization.",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "decay085_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "decay085_control",
      "change": "control: current season decay 0.85",

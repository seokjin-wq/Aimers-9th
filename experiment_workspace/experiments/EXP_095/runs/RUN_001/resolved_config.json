{
  "study": {
    "id": "095_same_hand_pitchmix_decomposition",
    "description": "Same-hand pitch-mix contribution decomposition",
    "hypothesis": "The three same-hand pitch-mix interactions contain unequal signal, so a smaller subset can improve Brier score by removing noisy interactions.",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "count_hands_base"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "count_hands_base",
      "change": "control: EXP_084 count+hands base without same-hand pitch-mix interactions",
      "model": {
        "name": "catboost_d8_decay085",
        "family": "catboost",
        "native_categorical": true,
        "season_decay": 0.85,
        "prediction_scale": 1.06,

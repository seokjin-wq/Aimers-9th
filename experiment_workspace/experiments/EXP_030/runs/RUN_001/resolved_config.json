{
  "study": {
    "id": "030_cpu_feature_confirmation",
    "description": "EDA 상위 피처 CPU 재검증",
    "hypothesis": "GPU 스크리닝에서 양의 효과를 보인 피처가 결정론적 CPU CatBoost에서도 control보다 개선한다",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "main60_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "main60_control",
      "change": "control: CPU main60",
      "model": {
        "name": "catboost_top_d6_i400_lr040",

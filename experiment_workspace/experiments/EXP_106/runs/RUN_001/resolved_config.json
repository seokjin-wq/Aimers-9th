{
  "study": {
    "id": "106_trackman_physics_decomposition",
    "description": "Latest-feature Trackman physics decomposition",
    "hypothesis": "The small Trackman gain seen on the earlier feature set comes from a subset of velocity, movement, or extension context and can complement the latest same-hand pitch-mix features.",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "same_pitchmix_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [

  "study": {
    "id": "122_extended_reliability_rates",
    "description": "Extended pitcher-history reliability rates",
    "hypothesis": "Reliability weighting that helped success/reverse/middle may also stabilize noisy pitcher ball/strike and pitch-mix rates for low-history pitchers.",

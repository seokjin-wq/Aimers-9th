{
  "study": {
    "id": "109_latest_catboost_regularization",
    "description": "Latest CatBoost local regularization sweep",
    "hypothesis": "The expanded 72-feature representation may prefer nearby regularization settings different from the early 55-feature model, improving probability calibration without changing row-independent inputs.",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "regularization_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "regularization_control",
      "change": "control: l2=3, random_strength=1, subsample=0.7, rsm=1",
      "model": {
        "name": "catboost_d8_decay085",
        "family": "catboost",
        "native_categorical": true,
        "season_decay": 0.85,
        "prediction_scale": 1.06,
        "prediction_shift": -0.008,
        "params": {
          "iterations": 300,
          "depth": 8,
          "learning_rate": 0.035,
          "l2_leaf_reg": 3.0,
          "subsample": 0.7,
          "random_seed": 42,
          "thread_count": 8,
          "task_type": "CPU",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        }
      },
      "features": {
        "name": "main72_cat_count_hands_same_pitchmix",
        "description": "EXP_080 CPU base plus same-hand by three historical pitch-mix interactions",

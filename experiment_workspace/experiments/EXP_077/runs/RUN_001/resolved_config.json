{
  "study": {
    "id": "077_direct_brier_revisit",
    "description": "강화 피처에서 CatBoost RMSE 직접 최적화 재검증",
    "hypothesis": "당해 시즌 상태와 최근성 가중치가 추가된 환경에서는 제곱오차를 직접 학습하는 회귀 CatBoost가 Logloss보다 Brier를 낮추거나 앙상블 다양성을 제공한다.",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "logloss_d8_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "logloss_d8_control",
      "change": "control: Logloss depth8 300",
      "model": {
        "name": "catboost_d8_decay085",
        "family": "catboost",
        "native_categorical": true,
        "season_decay": 0.85,
        "prediction_scale": 1.06,
        "prediction_shift": -0.008,
        "params": {
          "iterations": 300,
          "depth": 8,
          "learning_rate": 0.035,
          "l2_leaf_reg": 3.0,
          "subsample": 0.7,
          "random_seed": 42,
          "thread_count": 8,
          "task_type": "CPU",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        }
      },
      "features": {
        "name": "main69_pitcher_batter_season_all",

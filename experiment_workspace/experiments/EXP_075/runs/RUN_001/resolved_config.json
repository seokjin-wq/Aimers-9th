{
  "study": {
    "id": "075_success_k50_factorial",
    "description": "투수·타자 당해 시즌 성공률 k=50 기여 분해",
    "hypothesis": "k=50의 소폭 개선은 투수 또는 타자 한쪽에서만 나올 수 있으므로 기여 요소만 유지하면 추가 개선된다.",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "k20_k20_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },

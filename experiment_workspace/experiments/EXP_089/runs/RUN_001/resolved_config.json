{
  "study": {
    "id": "089_safe_season_progress",
    "description": "공식 학습 경계와 현재 행 ID만 쓰는 시즌 진행도",
    "hypothesis": "월보다 세밀한 시즌 내 진행도가 시간 드리프트를 포착한다.",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "same_hand_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },

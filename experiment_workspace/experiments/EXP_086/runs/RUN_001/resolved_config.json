{
  "study": {
    "id": "086_exact_season_snapshots",
    "description": "직전 시즌 마지막 공식 타깃까지 닫은 정확한 시즌 상태",
    "hypothesis": "기존 시즌 상태의 선수별 한 투구 off-by-one을 제거하면 특히 시즌 초 확률이 정확해진다.",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "approximate_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [

{
  "study": {
    "id": "019_identifier_categorical",
    "description": "식별자 범주형 개별 기여",
    "hypothesis": "팀 또는 선수 ID를 한꺼번에 범주화한 이전 실험의 악화는 일부 ID 때문이며, 개별 범주화는 잔차 편향을 줄인다",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "numeric_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "numeric_control",
      "change": "control: 기본 3개만 범주형",
      "model": {
        "name": "catboost_native_shift_m010",
        "family": "catboost",
        "native_categorical": true,
        "prediction_shift": -0.01,
        "params": {
          "iterations": 300,
          "depth": 6,
          "learning_rate": 0.05,
          "l2_leaf_reg": 3.0,
          "subsample": 0.7,
          "random_seed": 42,
          "thread_count": 8,
          "task_type": "CPU",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        }
      },
      "features": {
        "name": "main55_plus_count",
        "description": "main55 + 카운트·아웃 상태 플래그 5개",
        "include_all_raw": true,
        "exclude": [
          "run_total_before",
          "score_diff_home",
          "asof_pitcher_pitchmix_n",
          "asof_pitcher_strike_rate",
          "asof_pitcher_fastball_rate",
          "asof_pitcher_prev5_game_success_rate"
        ],
        "custom": [
          "pitcher_gap_prev1_career",
          "pitcher_gap_prev3_career",
          "pitcher_gap_prev5_career",
          "win_expectancy_dist50",
          "count_diff",
          "count_total",
          "same_hand_matchup",
          "pressure_x_recent_form",
          "runners_x_li",
          "batter_success_rate_shrunk",
          "reverse_rate_x_li",
          "middle_rate_x_count_diff",
          "late_inning_x_recent_form",
          "offspeed_x_li",
          "count_state",
          "is_full_count",
          "has_two_strikes",
          "has_three_balls",
          "has_two_outs"
        ],
        "categorical": [
          "top_bottom",
          "game_type",
          "base_state"
        ],
        "expected_count": 60
      },
      "changed_fields_vs_control": []

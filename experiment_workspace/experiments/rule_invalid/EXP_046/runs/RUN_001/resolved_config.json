{
  "study": {
    "id": "046_sequence_diverse_boosting",
    "description": "순차 피처 이종 부스팅 재검증",
    "hypothesis": "main80의 이종 모델 오차가 CatBoost를 보완한다",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "cat_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "cat_control",
      "change": "control: CPU CatBoost",
      "model": {
        "name": "catboost_top_d6_i400_lr040",
        "family": "catboost",
        "native_categorical": true,
        "prediction_scale": 1.06,
        "prediction_shift": -0.008,
        "params": {
          "iterations": 400,
          "depth": 6,
          "learning_rate": 0.04,
          "l2_leaf_reg": 3.0,
          "subsample": 0.7,
          "random_seed": 42,
          "thread_count": 8,
          "task_type": "CPU",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        }
      },
      "features": {
        "name": "main80_add_best_ewm",
        "description": "main77 + 투수 success05·reverse05 및 타자 success20 EWMA",

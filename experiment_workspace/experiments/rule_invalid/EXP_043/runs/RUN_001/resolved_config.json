{
  "study": {
    "id": "043_cpu_sequence_verification",
    "description": "순차 피처 CPU 결정론 재검증",
    "hypothesis": "GPU의 순차 피처 개선이 CPU 고정 모델에서도 재현된다",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "main60_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "main60_control",
      "change": "control: 순차 피처 없음",

{
  "study": {
    "id": "039_sequence_capacity",
    "description": "순차 피처 CatBoost 용량 재탐색",
    "hypothesis": "main85는 기존 모델보다 다른 깊이·학습 길이가 적합하다",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "d6_i600_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [

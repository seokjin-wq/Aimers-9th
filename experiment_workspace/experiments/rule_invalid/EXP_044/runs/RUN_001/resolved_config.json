{
  "study": {
    "id": "044_cpu_window_pruning",
    "description": "CPU 투수 장기·타자 단기 창 정리",
    "hypothesis": "타자 2·8 창 제거와 투수 장기 창 선별이 main77을 개선한다",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "main77_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },

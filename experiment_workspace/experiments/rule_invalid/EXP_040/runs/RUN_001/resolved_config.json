{
  "study": {
    "id": "040_sequence_diverse_models",
    "description": "순차 피처 이종 모델 후보",
    "hypothesis": "순차 피처 ExtraTrees와 seed 평균이 CatBoost 오차를 보완한다",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "cat_single_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "cat_single_control",
      "change": "control: CatBoost depth6 900",
      "model": {
        "name": "catboost_gpu_d6_i900_lr020_b128",
        "family": "catboost",
        "native_categorical": true,
        "prediction_scale": 1.06,
        "prediction_shift": -0.008,
        "params": {
          "iterations": 900,
          "depth": 6,
          "learning_rate": 0.02,
          "l2_leaf_reg": 3.0,
          "bootstrap_type": "Bayesian",
          "bagging_temperature": 1.0,
          "border_count": 128,
          "random_seed": 42,
          "task_type": "GPU",
          "devices": "0",

{
  "study": {
    "id": "049_cpu_global_window_upper",
    "description": "CPU 전역 rolling 상단 탐색",
    "hypothesis": "window200 주변 상단에 더 나은 단일 창이 있다",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "global200_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "global200_control",
      "change": "control: window200",
      "model": {
        "name": "catboost_top_d6_i400_lr040",
        "family": "catboost",
        "native_categorical": true,
        "prediction_scale": 1.06,
        "prediction_shift": -0.008,
        "params": {
          "iterations": 400,
          "depth": 6,
          "learning_rate": 0.04,
          "l2_leaf_reg": 3.0,
          "subsample": 0.7,
          "random_seed": 42,
          "thread_count": 8,
          "task_type": "CPU",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        }
      },
      "features": {
        "name": "main81_add_global200",
        "description": "main80 + 전역 recent200 성공률",
        "include_all_raw": true,
        "exclude": [
          "run_total_before",
          "score_diff_home",
          "asof_pitcher_pitchmix_n",

{
  "study": {
    "id": "exp_053",
    "description": "context grouped rolling signals",
    "hypothesis": "경기·공격팀별 최근 success/middle 비율이 global200이 놓친 환경 편향을 보완한다",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",

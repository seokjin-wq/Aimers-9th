{
  "study": {
    "id": "050_global200_cpu_capacity",
    "description": "global200 CPU CatBoost 용량 탐색",
    "hypothesis": "global200은 기존과 다른 트리 용량에서 잔여 신호를 더 학습한다",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "d6_i400_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "d6_i400_control",
      "change": "control: depth6 400 lr0.04",
      "model": {
        "name": "catboost_top_d6_i400_lr040",
        "family": "catboost",
        "native_categorical": true,
        "prediction_scale": 1.06,
        "prediction_shift": -0.008,
        "params": {
          "iterations": 400,
          "depth": 6,
          "learning_rate": 0.04,
          "l2_leaf_reg": 3.0,
          "subsample": 0.7,
          "random_seed": 42,
          "thread_count": 8,
          "task_type": "CPU",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        }
      },
      "features": {
        "name": "main81_add_global200",
        "description": "main80 + 전역 recent200 성공률",

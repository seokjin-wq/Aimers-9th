{
  "study": {
    "id": "082_context_categories",
    "description": "카운트×양손 기준의 인접 상황 범주 추가",
    "hypothesis": "카운트와 양손 범주가 활성화된 상태에서 아웃·이닝·팀·월·원시 카운트·주자수 중 하나가 고차 상호작용을 추가한다.",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "count_hands_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [

{
  "study": {
    "id": "074_safe_trackman_context",
    "description": "익명 투수 연결 폐기 후 안전한 Trackman 상황 집계 재검증",
    "hypothesis": "선수 연결은 불안정하지만, 2019~2023 공식 Trackman만으로 만든 손 유형×카운트 물리·구종 평균은 검증 행 집계 없이 추가 신호를 줄 수 있다.",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "success_k50_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [

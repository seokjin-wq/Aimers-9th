  "study": {
    "id": "008_eda_feature_groups",
    "description": "EDA 제안 피처 묶음 비교",
    "hypothesis": "EDA에서 확인한 결측·스무딩·경기 맥락·카운트 피처 중 일부가 main55의 2024 Brier를 개선한다",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "main55_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },

{
  "study": {
    "id": "013_direct_brier_objective",
    "description": "Brier 직접 최적화 회귀 부스팅",
    "hypothesis": "0/1 타깃을 제곱오차로 직접 학습하는 회귀 부스팅이 Logloss 분류보다 2024 Brier를 개선한다",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "catboost_logloss_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "catboost_logloss_control",
      "change": "control: CatBoost Logloss classifier",
      "model": {
        "name": "catboost_native_300",
        "family": "catboost",
        "native_categorical": true,
        "params": {
          "iterations": 300,
          "depth": 6,
          "learning_rate": 0.05,
          "l2_leaf_reg": 3.0,
          "subsample": 0.7,
          "random_seed": 42,
          "thread_count": 8,
          "task_type": "CPU",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        }
      },
      "features": {
        "name": "main55_plus_count",
        "description": "main55 + 카운트·아웃 상태 플래그 5개",
        "include_all_raw": true,
        "exclude": [
          "run_total_before",

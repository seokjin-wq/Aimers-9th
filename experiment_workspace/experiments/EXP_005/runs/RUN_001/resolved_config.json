{
  "study": {
    "id": "005_categorical_scope",
    "description": "CatBoost 범주 컬럼 범위",
    "hypothesis": "숫자 코드인 선수·팀·이산 상황 변수를 명목 범주로 처리하면 2024 Brier가 개선된다",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "basic3_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "basic3_control",
      "change": "control: 문자열 3개만 native categorical",
      "model": {
        "name": "catboost_native_300",
        "family": "catboost",
        "native_categorical": true,
        "params": {
          "iterations": 300,
          "depth": 6,
          "learning_rate": 0.05,
          "l2_leaf_reg": 3.0,
          "subsample": 0.7,
          "random_seed": 42,
          "thread_count": 8,
          "task_type": "CPU",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        }
      },
      "features": {

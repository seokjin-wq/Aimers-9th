{
  "study": {
    "id": "017_count_feature_contribution",
    "description": "카운트 피처 개별 기여",
    "hypothesis": "카운트 파생 5개 중 일부가 개선 대부분을 만들며 count_state 범주화가 추가 개선한다",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "main55_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "main55_control",
      "change": "control: main55 + shift",
      "model": {
        "name": "catboost_native_shift_m010",
        "family": "catboost",
        "native_categorical": true,
        "prediction_shift": -0.01,
        "params": {
          "iterations": 300,
          "depth": 6,
          "learning_rate": 0.05,
          "l2_leaf_reg": 3.0,
          "subsample": 0.7,
          "random_seed": 42,
          "thread_count": 8,
          "task_type": "CPU",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        }
      },
      "features": {
        "name": "main55",
        "description": "선택 제공 41개와 행 단위 파생 14개",
        "include_all_raw": true,

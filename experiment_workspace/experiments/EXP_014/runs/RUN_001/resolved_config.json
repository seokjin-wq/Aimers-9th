          "offspeed_x_li",
          "count_state",
          "is_full_count",
          "has_two_strikes",
          "has_three_balls",
          "has_two_outs"
        ],
        "categorical": [
          "top_bottom",
          "game_type",
          "base_state"
        ],
        "expected_count": 60

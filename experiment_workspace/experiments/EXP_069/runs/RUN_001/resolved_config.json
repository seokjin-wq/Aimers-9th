{
  "study": {
    "id": "069_season_state_gpu_capacity",
    "description": "시즌 상태 GPU 고용량 CatBoost",
    "hypothesis": "GPU의 더 많은 border와 450~900 trees가 현재 시즌 상태의 세밀한 비선형 잔차를 CPU depth8보다 잘 포착한다",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "cpu_d8"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "cpu_d8",
      "change": "control: CPU depth8 300",
      "model": {
        "name": "catboost_d8_decay085",
        "family": "catboost",
        "native_categorical": true,
        "season_decay": 0.85,
        "prediction_scale": 1.06,
        "prediction_shift": -0.008,
        "params": {
          "iterations": 300,
          "depth": 8,
          "learning_rate": 0.035,
          "l2_leaf_reg": 3.0,
          "subsample": 0.7,
          "random_seed": 42,
          "thread_count": 8,
          "task_type": "CPU",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        }
      },
      "features": {
        "name": "main69_pitcher_batter_season_all",
        "description": "main60 + official-train snapshot current-season pitcher/batter state",
        "include_all_raw": true,
        "exclude": [

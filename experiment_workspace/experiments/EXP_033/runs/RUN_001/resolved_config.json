{
  "study": {
    "id": "033_probability_calibration",
    "description": "직전 시즌 확률 보정",
    "hypothesis": "직전 시즌 out-of-time 예측으로 학습한 보정 함수가 다음 시즌 calibration을 개선한다",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "global_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "global_control",
      "change": "control: 직접 고른 affine 보정 GPU CatBoost",
      "model": {
        "name": "catboost_gpu_d6_i600_lr025_b128",
        "family": "catboost",
        "native_categorical": true,
        "prediction_scale": 1.06,
        "prediction_shift": -0.008,
        "params": {
          "iterations": 600,
          "depth": 6,
          "learning_rate": 0.025,
          "l2_leaf_reg": 3.0,
          "bootstrap_type": "Bayesian",
          "bagging_temperature": 1.0,
          "border_count": 128,
          "random_seed": 42,
          "task_type": "GPU",
          "devices": "0",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        }
      },
      "features": {
        "name": "main60_cat_batter_team",
        "description": "main55+count에서 batter_team_id만 범주형",
        "include_all_raw": true,
        "exclude": [
          "run_total_before",
          "score_diff_home",
          "asof_pitcher_pitchmix_n",
          "asof_pitcher_strike_rate",
          "asof_pitcher_fastball_rate",
          "asof_pitcher_prev5_game_success_rate"
        ],
        "custom": [
          "pitcher_gap_prev1_career",
          "pitcher_gap_prev3_career",
          "pitcher_gap_prev5_career",
          "win_expectancy_dist50",
          "count_diff",
          "count_total",
          "same_hand_matchup",
          "pressure_x_recent_form",
          "runners_x_li",
          "batter_success_rate_shrunk",
          "reverse_rate_x_li",
          "middle_rate_x_count_diff",
          "late_inning_x_recent_form",
          "offspeed_x_li",
          "count_state",
          "is_full_count",
          "has_two_strikes",
          "has_three_balls",
          "has_two_outs"
        ],
        "categorical": [
          "top_bottom",
          "game_type",
          "base_state",
          "batter_team_id"
        ],
        "expected_count": 60
      },
      "changed_fields_vs_control": []
    },

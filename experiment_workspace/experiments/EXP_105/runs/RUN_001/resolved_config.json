{
  "study": {
    "id": "105_official_train_context_effects",
    "description": "Official-train context target effects",
    "hypothesis": "Season-OOF context target effects fitted only on official training seasons provide stable nonlinear priors that CatBoost cannot recover efficiently from raw count, hand, inning, and base-state columns alone.",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "same_pitchmix_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [

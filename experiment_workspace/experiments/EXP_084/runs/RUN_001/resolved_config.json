  "study": {
    "id": "084_hand_pitchmix_interactions",
    "description": "EDA 기반 손 조합과 사전 구종 구성의 행 단위 상호작용",
    "hypothesis": "손 조합별로 과거 구종 구성과 제구 성공의 기울기가 달라 명시적 교호항이 추가 신호를 준다.",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "count_hands_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42

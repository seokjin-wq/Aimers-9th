{
  "study": {
    "id": "083_recent_form_blends",
    "description": "평가 행 자체의 사전 제공 최근경기 통계 조합",
    "hypothesis": "직전 1·3·5경기 성공·가운데 비율을 안정적으로 요약하면 개별 원시 horizon보다 일반화가 좋아진다.",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "count_hands_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },

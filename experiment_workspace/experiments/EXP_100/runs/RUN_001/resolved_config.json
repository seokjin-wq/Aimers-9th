{
  "study": {
    "id": "100_latest_affine_refinement",
    "description": "Latest-feature affine probability refinement",
    "hypothesis": "The latest 72-feature CatBoost has a different optimal probability spread and mean than the earlier main60 model, so small scale or shift changes can reduce Brier.",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "scale106_shift008_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },

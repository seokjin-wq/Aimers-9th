{
  "study": {
    "id": "118_reliability_capacity_refresh",
    "description": "Reliability-feature CatBoost capacity refresh",
    "hypothesis": "Adding six reliability features changes model complexity needs; a deeper or longer schedule may capture the new interactions better than the old depth8/300 setting.",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "d8_i300_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "d8_i300_control",
      "change": "control: reliability CPU depth8, 300 trees, lr0.035",
      "model": {
        "name": "catboost_d8_decay085_sub08",
        "family": "catboost",
        "native_categorical": true,
        "season_decay": 0.85,
        "prediction_scale": 1.06,
        "prediction_shift": -0.008,
        "params": {
          "iterations": 300,
          "depth": 8,
          "learning_rate": 0.035,
          "l2_leaf_reg": 3.0,
          "subsample": 0.8,
          "random_seed": 42,
          "thread_count": 8,
          "task_type": "CPU",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        }
      },
      "features": {
        "name": "main78_history_reliability",
        "description": "main72 plus six row-local as-of sample reliability features",
        "include_all_raw": true,
        "exclude": [
          "run_total_before",
          "score_diff_home",

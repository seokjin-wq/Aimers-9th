{
  "study": {
    "id": "113_reliability_decomposition",
    "description": "History reliability block decomposition",
    "hypothesis": "The EXP_112 gain is concentrated in one of reliability level, success-rate weighting, or reverse/middle weighting; removing non-contributing blocks can reduce noise.",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "all_six_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "all_six_control",
      "change": "control: EXP_112 six-feature reliability winner",
      "model": {
        "name": "catboost_d8_decay085_sub08",
        "family": "catboost",
        "native_categorical": true,
        "season_decay": 0.85,
        "prediction_scale": 1.06,

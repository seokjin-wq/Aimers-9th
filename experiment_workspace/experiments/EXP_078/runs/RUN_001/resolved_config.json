{
  "study": {
    "id": "078_low_card_categorical",
    "description": "저카디널리티 블록별 CatBoost 범주 처리",
    "hypothesis": "의미상 이산적인 블록을 한 번에 하나씩 native categorical로 처리하면 숫자 임계값보다 정확한 조건부 확률을 학습할 수 있다.",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "main69_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },

{
  "study": {
    "id": "059_season_state_catboost_capacity",
    "description": "시즌 상태 CatBoost 용량 재탐색",
    "hypothesis": "새로운 현재 시즌 상태 신호는 기존 main60과 다른 최적 트리 깊이·반복 수를 가질 수 있다",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "d6_i300_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },

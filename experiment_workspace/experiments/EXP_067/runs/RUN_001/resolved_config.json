{
  "study": {
    "id": "067_2023_residual_catboost",
    "description": "2023 잔차 CatBoost 보정",
    "hypothesis": "2019~2022 모델의 2023 OOT 잔차에서 반복되는 비선형 패턴을 학습하면 2024 예측의 남은 편향을 줄일 수 있다",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "base_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "base_control",
      "change": "control: EXP_060 depth8 decay85",
      "model": {
        "name": "catboost_d8_decay085",
        "family": "catboost",
        "native_categorical": true,
        "season_decay": 0.85,
        "prediction_scale": 1.06,
        "prediction_shift": -0.008,
        "params": {
          "iterations": 300,
          "depth": 8,
          "learning_rate": 0.035,
          "l2_leaf_reg": 3.0,
          "subsample": 0.7,
          "random_seed": 42,
          "thread_count": 8,
          "task_type": "CPU",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        }
      },
      "features": {
        "name": "main69_pitcher_batter_season_all",
        "description": "main60 + official-train snapshot current-season pitcher/batter state",
        "include_all_raw": true,
        "exclude": [
          "run_total_before",
          "score_diff_home",
          "asof_pitcher_pitchmix_n",

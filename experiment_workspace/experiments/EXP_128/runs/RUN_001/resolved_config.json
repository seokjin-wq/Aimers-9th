{
  "study": {
    "id": "128_count_trend_strength_refinement",
    "description": "Count trend strength refinement",
    "hypothesis": "The EXP_127 count-relative trend gain has a local optimum near full strength; testing 0.75, 1.25, and 1.50 will improve or confirm strength 1.00.",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "strength_100_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "strength_100_control",
      "change": "control: EXP_127 adopted trend strength 1.00",
      "model": {
        "name": "triple_count_trend_s100",
        "family": "cat_cpu_gpu_extra_blend",
        "cpu_weight": 0.5,
        "gpu_weight": 0.35,
        "extra_weight": 0.15,
        "season_decay": 0.85,
        "cat_scale": 1.06,
        "cat_shift": -0.0095,
        "extra_shift": -0.01,
        "group_columns": [
          "balls_before",
          "strikes_before"
        ],
        "group_shrinkage": 500.0,
        "center_residual": true,
        "residual_scale": 1.0,
        "trend_group_columns": [
          "balls_before",
          "strikes_before"
        ],
        "trend_strength": 1.0,
        "trend_shrinkage": 10000.0,
        "cpu_params": {
          "iterations": 300,
          "depth": 8,
          "learning_rate": 0.035,
          "l2_leaf_reg": 3.0,
          "subsample": 0.8,
          "random_seed": 42,
          "thread_count": 8,
          "task_type": "CPU",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        },
        "gpu_params": {
          "iterations": 600,
          "depth": 7,
          "learning_rate": 0.025,
          "l2_leaf_reg": 3.0,
          "bootstrap_type": "Bayesian",
          "bagging_temperature": 1.0,
          "border_count": 128,
          "random_seed": 42,
          "task_type": "GPU",
          "devices": "0",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        },
        "extra_params": {
          "n_estimators": 300,
          "min_samples_leaf": 20,
          "max_features": 0.7,
          "n_jobs": 8,
          "random_state": 42,
          "verbose": 0
        }
      },
      "features": {
        "name": "main78_history_reliability",
        "description": "main72 plus six row-local as-of sample reliability features",
        "include_all_raw": true,
        "exclude": [
          "run_total_before",
          "score_diff_home",
          "asof_pitcher_pitchmix_n",

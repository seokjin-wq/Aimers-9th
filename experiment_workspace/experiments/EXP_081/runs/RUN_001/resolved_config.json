{
  "study": {
    "id": "081_composite_count_states",
    "description": "행 단위 복합 카운트 상태 범주",
    "hypothesis": "카운트와 손·아웃 상호작용을 하나의 복합 범주로 직접 표현하면 separate categorical보다 ordered statistics가 안정적으로 학습된다.",
    "protocol": "holdout_2024",
    "change_scope": [
      "features"
    ],
    "control": "separate_count_hands_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "separate_count_hands_control",
      "change": "control: count_state와 양손을 separate categorical",
      "model": {
        "name": "catboost_d8_decay085",
        "family": "catboost",
        "native_categorical": true,
        "season_decay": 0.85,
        "prediction_scale": 1.06,
        "prediction_shift": -0.008,
        "params": {
          "iterations": 300,
          "depth": 8,

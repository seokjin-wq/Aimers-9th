{
  "study": {
    "id": "070_cpu_gpu_extra_triple",
    "description": "CPU·GPU·ExtraTrees 3모델 앙상블",
    "hypothesis": "CPU CatBoost, GPU CatBoost, ExtraTrees의 서로 다른 오차를 결합하면 2모델 앙상블보다 Brier가 낮아진다",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "cpu_only"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "cpu_only",
      "change": "control: CPU depth8 decay85",
      "model": {
        "name": "catboost_d8_decay085",
        "family": "catboost",
        "native_categorical": true,
        "season_decay": 0.85,
        "prediction_scale": 1.06,
        "prediction_shift": -0.008,
        "params": {
          "iterations": 300,
          "depth": 8,
          "learning_rate": 0.035,
          "l2_leaf_reg": 3.0,
          "subsample": 0.7,
          "random_seed": 42,
          "thread_count": 8,
          "task_type": "CPU",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        }
      },
      "features": {
        "name": "main69_pitcher_batter_season_all",
        "description": "main60 + official-train snapshot current-season pitcher/batter state",
        "include_all_raw": true,
        "exclude": [

{
  "study": {
    "id": "120_reliability_categorical_processing",
    "description": "Reliability CatBoost categorical processing",
    "hypothesis": "The expanded categorical and reliability representation may benefit from richer CatBoost CTR combinations or different one-hot thresholds even though tree-capacity changes failed.",
    "protocol": "holdout_2024",
    "change_scope": [
      "model"
    ],
    "control": "categorical_control"
  },
  "protocol": {
    "name": "holdout_2024",
    "description": "2019~2023 전체로 학습하고 2024를 고정 primary holdout으로 검증",
    "train_start_season": 2019,
    "validation_seasons": [
      2024
    ],
    "split_rule": "before_validation_season",
    "primary_metric": "brier",
    "secondary_metrics": [
      "brier_skill_score",
      "roc_auc"
    ],
    "target_column": "control_success",
    "id_column": "row_id",
    "season_column": "season",
    "store_predictions": true,
    "calibration": "none",
    "seed": 42
  },
  "variants": [
    {
      "name": "categorical_control",
      "change": "control: latest CPU default categorical processing",
      "model": {
        "name": "catboost_d8_decay085_sub08",
        "family": "catboost",
        "native_categorical": true,
        "season_decay": 0.85,
        "prediction_scale": 1.06,
        "prediction_shift": -0.008,
        "params": {
          "iterations": 300,
          "depth": 8,
          "learning_rate": 0.035,
          "l2_leaf_reg": 3.0,
          "subsample": 0.8,
          "random_seed": 42,
          "thread_count": 8,
          "task_type": "CPU",
          "loss_function": "Logloss",
          "eval_metric": "BrierScore",
          "allow_writing_files": false,
          "verbose": false
        }
      },
      "features": {
